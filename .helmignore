# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Package files
*.tgz
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
helpers/
manifests/
media/
samples/
work/
LICENSE
README.md
Makefile
csp.yaml
hdr-rw.yaml
tlspolicy.yaml
